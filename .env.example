# Copy to `.env` and fill in. `npm run setup` reads this file to produce
# wrangler.jsonc from wrangler.example.jsonc.
#
# .env and wrangler.jsonc are both gitignored. Only .env.example and
# wrangler.example.jsonc are committed.

# Cloudflare account id. Find it under the right-hand sidebar of any zone in
# the Cloudflare dashboard, or by running `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# Hostname the Worker should serve from. Must be a DNS name on a zone in the
# same Cloudflare account (e.g. o.example.com). Wrangler will provision the
# DNS record and a custom-domain cert on first deploy.
#
# If you don't have a custom domain, leave blank and a *.workers.dev subdomain
# will be used instead. (You will need to remove the `routes` block from
# wrangler.example.jsonc by hand in that case — workers.dev is the default.)
RESOLVER_HOSTNAME=

# Your Obsidian vault name, exactly as shown in Advanced URI plugin settings.
# This is the string Obsidian uses to identify the vault — it is NOT the R2
# bucket name, NOT the folder name on disk. Open Obsidian → Settings →
# Advanced URI → "Vault name parameter" to confirm.
VAULT_NAME=
